+
+/**
+ * Strip `tool_result` blocks whose `tool_use_id` has no matching `tool_use` block
+ * earlier in the same request body. Anthropic's Messages API requires every
+ * `tool_result` to be preceded by the `assistant` `tool_use` that produced it; an
+ * orphan `tool_result` triggers a 400 ("unexpected `tool_use_id` found in
+ * `tool_result` blocks"). This removes those orphan blocks in place.
+ *
+ * The `messages` array is mutated directly. A `user` message left with no content
+ * blocks after stripping is removed so the request stays valid.
+ */
+function stripOrphanToolResults(messages: any[], requestId: string, logger: Logger): void {
+    // Collect every tool_use id that appears in an assistant message.
+    const knownToolUseIds = new Set<string>();
+    for (const msg of messages) {
+        if (msg?.role === 'assistant' && Array.isArray(msg.content)) {
+            for (const block of msg.content) {
+                if (block?.type === 'tool_use' && typeof block.id === 'string') {
+                    knownToolUseIds.add(block.id);
+                }
+            }
+        }
+    }
+
+    const strippedIds: string[] = [];
+    for (let i = messages.length - 1; i >= 0; i--) {
+        const msg = messages[i];
+        if (msg?.role !== 'user' || !Array.isArray(msg.content)) {
+            continue;
+        }
+
+        const kept = msg.content.filter((block: any) => {
+            if (block?.type === 'tool_result' && !knownToolUseIds.has(block?.tool_use_id)) {
+                strippedIds.push(block?.tool_use_id ?? '(missing)');
+                return false;
+            }
+            return true;
+        });
+
+        if (kept.length === msg.content.length) {
+            continue;
+        }
+
+        if (kept.length === 0) {
+            // No content left after stripping — drop the whole message.
+            messages.splice(i, 1);
+        } else {
+            msg.content = kept;
+        }
+    }
+
+    if (strippedIds.length > 0) {
+        logger.warn(
+            requestId,
+            `TOOL_ID_MISS_CHECK: stripped ${strippedIds.length} orphan tool_result block(s) with no matching tool_use: ${strippedIds.join(', ')}`,
+        );
+    }
+}
