deepseek-v4-comp = {target = "deepseek-v4-flash", base_url = "https://api.deepseek.com", api_key = "sk-***", transforms = "deepseek_v4_comp_compat"}
deepseek-v4-anth = {target = "deepseek-v4-flash", base_url = "https://api.deepseek.com/anthropic", api_key = "sk-***", mode = "anthropic-messages", transforms = "deepseek_v4_anthropic_compat"}


[transforms.deepseek_v4_comp_compat]
schema = "openai-completions"
before_upstream.ops = [
  {op = "default", path = "messages[role=assistant].reasoning_content", value = ""},
]

[transforms.deepseek_v4_anthropic_compat]
schema = "anthropic-messages"
request_ingress.builtins = ["lowercase_tool_schema_types"]
before_upstream.builtins = ["inject_missing_tool_results"]

# tranforms.* is unused if which is un-referenced in any model or section
[transforms.minimax_compat]
schema = "openai-completions"
before_upstream.ops = [
  {op = "map_value", path = "messages[role=assistant].content", when_sibling = "tool_calls", from = "", to = null},
]

[transforms.max_tokens_rename]
schema = "openai-completions"
before_upstream.ops = [
  {op = "rename", path = "max_tokens", to = "max_completion_tokens"},
]

[transforms.writeout_marker]
schema = "openai-completions"
response_egress.ops = [
  {op = "set", path = "$response.id", value = "step12_response_path_active"},
]

# Beta-header filtering/mapping. Attach filter_anthropic_beta at before_upstream
# and declare an anthropic_beta_map: entries not in the map are dropped; entries
# mapped to "" are dropped; others are emitted under the mapped name (rename).
# See docs/claude-beta-headers.md and docs/transforms-reference.md.
[transforms.bedrock_beta_compat]
schema = "anthropic-messages"
anthropic_beta_map = {"computer-use-2025-01-24" = "computer-use-2025-01-24", "advanced-tool-use-2025-11-20" = "tool-search-tool-2025-10-19", "unsupported-feature" = ""}
before_upstream.builtins = ["filter_anthropic_beta"]

# Translate Anthropic-native prompt caching on the system prompt into the
# litellm/Bedrock-bridge convention. Reads cache_control from body.system
# content blocks (array-of-blocks shape), then appends a
#   {location = "tool_config", control = {type = "ephemeral", ttl = "1h"}}
# entry to body.cache_control_injection_points when no tool_config entry
# already exists (caller wins). The serialized body is reordered so
# cache_control_injection_points lands after tools.
# Attach to any bedrock-via-litellm route that uses system-prompt caching.
[transforms.bedrock_tool_cache_ttl_compat]
schema = "anthropic-messages"
before_upstream.builtins = ["ensure_tool_config_cache_ttl"]

[transform_defaults]
openai-completions = ["max_tokens_rename"]
openai-responses = ["max_tokens_rename"]
